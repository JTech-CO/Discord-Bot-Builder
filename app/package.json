{
  "name": "discord-bot-builder",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Design Discord bots as flowcharts, compile them into a prompt, and let AI write the code.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run clean && vite build --emptyOutDir false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "desktop:build": "node scripts/clean.mjs dist-electron && vite build --config vite.electron.config.ts",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "desktop:dev": "npm run desktop:build && electron . --dev-url=http://localhost:5173"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
