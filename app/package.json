{
  "name": "discord-bot-builder",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Design Discord bots as flowcharts, compile them into a prompt, and let AI write the code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run clean && vite build --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.48.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
