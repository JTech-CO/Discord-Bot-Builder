{
  "name": "discord-bot-builder",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Design Discord bots as flowcharts, compile them into a prompt, and let AI write the code.",
  "author": "JTech-CO",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run clean && vite build --emptyOutDir false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "desktop:build": "node scripts/clean.mjs dist-electron && vite build --config vite.electron.config.ts",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "desktop:dev": "npm run desktop:build && electron . --dev-url=http://localhost:5173",
    "icon": "electron scripts/make-icon.cjs",
    "dist:win": "npm run build && npm run desktop:build && node scripts/clean.mjs release && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "io.github.jtech-co.discord-bot-builder",
    "productName": "Discord Bot Builder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Discord Bot Builder",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "artifactName": "Discord-Bot-Builder-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
